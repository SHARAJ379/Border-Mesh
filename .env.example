# BorderMesh Configuration
PROJECT_NAME="BorderMesh — AI-Based Fake Identity & Document Screening System"
ENVIRONMENT="development"
DEMO_MODE=true

# Database (PostgreSQL with automatic SQLite fallback for zero-friction local run)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bordermesh"
# If running without local postgres, SQLite fallback URL:
# DATABASE_URL="sqlite:///./border_mesh.db"

# Storage
UPLOAD_DIR="./uploads"

# API & Security
# SECRET_KEY now also signs officer login sessions (JWT, HS256) -- see
# backend/app/core/security.py's create_access_token/decode_access_token.
SECRET_KEY="bordermesh-sih2026-demo-secret-key-change-in-production"
ALLOWED_HOSTS=["*"]

# Password for the one demo officer account (badge_id OFFICER-DEMO-01)
# auto-seeded on first boot -- see backend/app/main.py's lifespan. Real
# deployments should rotate/remove this account; there is no self-
# registration endpoint (an account on a border-screening system isn't
# self-service).
DEFAULT_OFFICER_PASSWORD="bordermesh-sih2026-demo-password-change-in-production"

# Fernet symmetric key encrypting every biometric artifact at rest (document
# scans, live face captures, face crops, tamper heatmaps, cross-case face
# embeddings -- see backend/app/core/encryption.py). A real key from an env
# var, but NOT production-grade key management: one static key, no
# rotation, no envelope encryption, no HSM/KMS (see README section 10B).
# Unlike ANCHOR_PRIVATE_KEY above, this one can't be left blank -- Fernet
# needs a valid key to even start up, so this ships with the same working
# demo default as backend/app/core/config.py (a real key, just not a secret
# one) rather than an empty string. Override with your own in any real
# deployment. Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY="GIdlRJ4jkqQin6vgx8uDRtGQ2EXnGhbd_jIXGEjS848="

# Risk Engine Configurable Weights (Must sum to 1.0)
WEIGHT_MRZ=0.25
WEIGHT_TAMPER=0.30
WEIGHT_FACE=0.30
WEIGHT_CONSISTENCY=0.10
WEIGHT_WATCHLIST=0.05

# Risk Level Thresholds
THRESHOLD_LOW=24
THRESHOLD_MEDIUM=49
THRESHOLD_HIGH=74
# 75-100 is CRITICAL

# OCR Engine
OCR_ENGINE="pytesseract" # options: pytesseract, mock
# Leave blank to use whatever `tesseract` resolves to on your PATH (works on
# any OS once tesseract-ocr is installed -- see README section 7, Option B).
# Only set this if your tesseract binary isn't already on PATH, e.g.:
#   TESSERACT_PATH="/opt/homebrew/bin/tesseract"   # macOS, Homebrew
#   TESSERACT_PATH="/usr/bin/tesseract"            # Debian/Ubuntu
TESSERACT_PATH=""

# Blockchain audit-chain anchoring (Ethereum Sepolia testnet) -- on-demand
# only, triggered by an officer clicking "Anchor now" on the Audit Trail page.
# Leave ANCHOR_PRIVATE_KEY blank to disable the feature entirely (the app
# works fully without it -- the local SHA-256 hash chain is unaffected).
# Set it to a THROWAWAY testnet-only wallet's private key -- never one
# holding anything of real value. Fund the matching address via a Sepolia
# faucet (e.g. https://www.alchemy.com/faucets/ethereum-sepolia).
ANCHOR_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
ANCHOR_CHAIN_ID=11155111
ANCHOR_NETWORK_NAME="Ethereum Sepolia"
ANCHOR_EXPLORER_TX_URL="https://sepolia.etherscan.io/tx/"
ANCHOR_PRIVATE_KEY=""

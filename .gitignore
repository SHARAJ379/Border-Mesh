# Environments
venv/
.venv/
.venv-backend/
.venv-train/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# Local-only ML datasets (CASIA v2.0, MIDV-2020, FG-NET -- see
# scripts/evaluate_*.py / scripts/finetune_*.py) -- multiple GB, never meant
# to be committed.
data/

# Model weight experiments/backups dropped into this directory. Explicitly
# keeps the one committed production checkpoint (tamper_cnn.pth) -- already-
# tracked files are unaffected by new ignore rules, so this doesn't untrack
# it; it only stops future stray/experimental weights (e.g. a *.pth.bak
# sanity-check backup) from being picked up by a broad `git add`.
backend/app/ml/weights/*
!backend/app/ml/weights/tamper_cnn.pth

# Node
node_modules/
dist/
.vite/
npm-debug.log*

# Database & Uploads
*.db
*.sqlite
*.sqlite3
uploads/
demo_output/

# IDE & OS
.DS_Store
.idea/
.vscode/
*.swp

# Environment variables
.env

# Local AI-tool MCP configs -- each hardcodes this machine's own absolute
# Windows path (including the local username) to launch the aletheore MCP
# server, which has no business being committed to a public repo.
.mcp.json

# Local Claude Code tooling (skill bundles, local settings, scheduler lock)
# -- machine-local, not project source.
.claude/
.codex/config.toml
.cursor/mcp.json
.kiro/settings/mcp.json
opencode.json

# Git worktrees
.worktrees/
.aletheore/
